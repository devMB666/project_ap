      "item": [
        {
          "name": "Готовность source-service",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"sourceId\", \"pm-\" + run);",
                  "pm.collectionVariables.set(\"manualId\", \"msg-\" + run);",
                  "pm.collectionVariables.set(\"seq\", \"1\");",
                  "pm.collectionVariables.set(\"measuredAt\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service\", () => { pm.expect(pm.response.json().service).to.eql(\"source-service\"); });",
                  "pm.test(\"status\", () => { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{sourceUrl}}/healthz",
              "host": [
                "{{sourceUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "response": []
